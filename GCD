public class Main
{
    public static int welcome(int a,int b)
    {
        
        int s = a;
        
        while(b!=0)
        {
            a = b;
            b = s % b;
        }
        return a;
    }
    public static void main(String []args)
    {
        int []a={8,10,4,15,12,18,28};
        int gcd=a[0];
        for(int i=1;i<7;i++)
        {
            gcd = welcome(gcd, a[i]);
        }
        System.out.println("The gcd is: "+gcd);
    }
}
